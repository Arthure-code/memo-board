{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Memos": "Data Source=memos.db"
  },
  "AllowedOrigins": [
    "http://localhost:4200"
  ],
  "Jwt": {
    "Issuer": "memo-board",
    "Audience": "memo-board",
    "LifetimeMinutes": 60
  },
  "RateLimiting": {
    "LoginAttemptsPerMinute": 5
  }
}
